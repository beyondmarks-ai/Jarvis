# Supply through process environment or your cloud secret store. Never put real values here.
JARVIS_MIC_TOKEN=YOUR_RANDOM_MICROPHONE_ACCESS_KEY
JARVIS_SPEAKER_TOKEN=YOUR_DIFFERENT_RANDOM_SPEAKER_ACCESS_KEY
SARVAM_API_KEY=YOUR_EXISTING_SARVAM_API_KEY
JARVIS_MODEL_DIR=.tmp_phone_models
JARVIS_MAX_MICROPHONES=3
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_SPEECH_RMS=500
# Optional exact browser origin allowlist, comma separated. Same-origin works without this.
JARVIS_ALLOWED_ORIGINS=
# Optional persistent shared memory. Azure deployment uses managed identity, never DB keys.
JARVIS_MEMORY_ENABLED=0
JARVIS_MEMORY_ENDPOINT=https://YOUR_COSMOS_ACCOUNT.documents.azure.com:443/
JARVIS_EMBEDDING_DIR=.tmp_memory_model
